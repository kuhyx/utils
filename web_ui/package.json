{
  "name": "@kuhyx/web-ui",
  "version": "0.5.0",
  "private": false,
  "type": "module",
  "description": "The shared token + component layer for kuhy's web apps: the frozen palette, spacing/radius/type scales as CSS custom properties, and the components that were each reimplemented in two or more repos.",
  "license": "MIT",
  "engines": {
    "node": ">=24",
    "pnpm": ">=10"
  },
  "packageManager": "pnpm@12.21.0+sha512.66fd8278ee28935ce951792d34367ff3af5c432a2756445823029533835b8da529bbe0be5130afd56ed0713fb8789e47bad82d93bd5ae2fe54b15562d6276ef0",
  "files": [
    "dist",
    "src/*.astro"
  ],
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./tokens.css": "./dist/tokens.css",
    "./range-slider.css": "./dist/range-slider.css",
    "./RangeSlider.astro": "./src/RangeSlider.astro",
    "./range-slider": "./dist/range-slider-element.js"
  },
  "scripts": {
    "build": "tsc -b && cp src/tokens.css src/range-slider.css dist/",
    "lint": "tsc --noEmit -p tsconfig.lint.json && eslint . && astro check",
    "test": "vitest run",
    "coverage": "vitest run --coverage"
  },
  "peerDependencies": {
    "astro": "7.4.12"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.12",
    "@emnapi/runtime": "1.11.3",
    "@eslint/js": "10.0.1",
    "@kuhyx/ts-config": "link:../ts_config",
    "@testing-library/dom": "10.4.2",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/user-event": "14.6.12",
    "@types/node": "26.6.6",
    "@vitest/coverage-v8": "5.1.1",
    "astro": "7.4.12",
    "eslint": "10.15.0",
    "jsdom": "31.0.1",
    "typescript": "6.0.3",
    "typescript-eslint": "8.73.0",
    "vitest": "5.1.1"
  }
}
