{
  "name": "@kuhyx/web-ui",
  "version": "0.5.0",
  "private": false,
  "type": "module",
  "description": "The shared token + component layer for kuhy's web apps: the frozen palette, spacing/radius/type scales as CSS custom properties, and the components that were each reimplemented in two or more repos.",
  "license": "MIT",
  "engines": {
    "node": ">=24",
    "pnpm": ">=10"
  },
  "packageManager": "pnpm@12.16.1+sha512.091d1dee7927575661b25dab3c2ae31cafc1c54d6b71ed6a6600cf0c1cb10434a447eae14015f1b23e2e6bedeed79df94a932e2164d2832280dce3fb32f656d1",
  "files": [
    "dist",
    "src/*.astro"
  ],
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./tokens.css": "./dist/tokens.css",
    "./range-slider.css": "./dist/range-slider.css",
    "./RangeSlider.astro": "./src/RangeSlider.astro",
    "./range-slider": "./dist/range-slider-element.js"
  },
  "scripts": {
    "build": "tsc -b && cp src/tokens.css src/range-slider.css dist/",
    "lint": "tsc --noEmit -p tsconfig.lint.json && eslint . && astro check",
    "test": "vitest run",
    "coverage": "vitest run --coverage"
  },
  "peerDependencies": {
    "astro": ">=7.4.0"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.12",
    "@eslint/js": "10.0.1",
    "@kuhyx/ts-config": "link:../ts_config",
    "@testing-library/dom": "10.4.2",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/user-event": "14.6.8",
    "@types/node": "26.6.6",
    "@vitest/coverage-v8": "5.0.5",
    "astro": "7.4.4",
    "eslint": "10.14.0",
    "jsdom": "30.1.3",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.1",
    "vitest": "5.0.5"
  }
}
