# Python build/test artifacts, across every subproject in this monorepo.
__pycache__/
*.py[cod]
*.egg-info/
build/
dist/
.venv/
.mypy_cache/
.ruff_cache/
.pytest_cache/

# Coverage output. Each subproject writes these next to its own pyproject.toml,
# and a run from the repo root drops a pair here too.
.coverage
.coverage.*
coverage.lcov
htmlcov/

# Firebase CLI debug exhaust. Written next to whichever directory the CLI was
# invoked from (crdt-sync/ in practice), regenerated on every failed command,
# and never worth committing.
firebase-debug.log
firebase-debug.*.log
firestore-debug.log
database-debug.log
