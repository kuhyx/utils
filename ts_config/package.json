{
  "name": "@kuhyx/ts-config",
  "version": "0.1.3",
  "private": false,
  "type": "module",
  "description": "The one lint/TypeScript bar every kuhyx TypeScript repo extends: a strict tsconfig base, ESLint flat-config presets (base, react, vitest, playwright, layer boundaries, a fast editor subset), and Knip / jscpd / Stryker bases. Plain JS, no build step -- consumable straight from a git tag.",
  "license": "MIT",
  "engines": {
    "node": ">=24",
    "pnpm": ">=10"
  },
  "packageManager": "pnpm@12.21.0+sha512.66fd8278ee28935ce951792d34367ff3af5c432a2756445823029533835b8da529bbe0be5130afd56ed0713fb8789e47bad82d93bd5ae2fe54b15562d6276ef0",
  "files": [
    "eslint",
    "tsconfig.base.json",
    "knip.base.json",
    "jscpd.base.json",
    "stryker.base.mjs",
    "scripts",
    "README.md"
  ],
  "exports": {
    ".": "./eslint/index.js",
    "./eslint": "./eslint/index.js",
    "./eslint/base": "./eslint/base.js",
    "./eslint/react": "./eslint/react.js",
    "./eslint/vitest": "./eslint/vitest.js",
    "./eslint/playwright": "./eslint/playwright.js",
    "./eslint/boundaries": "./eslint/boundaries.js",
    "./eslint/fast": "./eslint/fast.js",
    "./tsconfig": "./tsconfig.base.json",
    "./knip": "./knip.base.json",
    "./jscpd": "./jscpd.base.json",
    "./stryker": "./stryker.base.mjs"
  },
  "scripts": {
    "lint": "eslint .",
    "test": "vitest run",
    "coverage": "vitest run --coverage"
  },
  "dependencies": {
    "@eslint-react/eslint-plugin": "5.30.4",
    "@eslint/js": "10.0.1",
    "@vitest/eslint-plugin": "1.6.28",
    "eslint-import-resolver-typescript": "4.4.5",
    "eslint-plugin-boundaries": "7.4.4",
    "eslint-plugin-jsx-a11y": "6.10.2",
    "eslint-plugin-perfectionist": "5.14.0",
    "eslint-plugin-playwright": "2.12.2",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-react-refresh": "0.5.8",
    "eslint-plugin-react-you-might-not-need-an-effect": "1.2.0",
    "eslint-plugin-sonarjs": "4.2.2",
    "eslint-plugin-unicorn": "80.0.0",
    "globals": "17.14.0"
  },
  "peerDependencies": {
    "eslint": "10.15.0",
    "typescript": ">=6",
    "typescript-eslint": "8.73.0"
  },
  "devDependencies": {
    "@playwright/test": "1.65.1",
    "@types/react": "19.3.0",
    "@vitest/coverage-v8": "5.1.1",
    "eslint": "10.15.0",
    "react": "19.3.1",
    "typescript": "6.0.3",
    "typescript-eslint": "8.73.0",
    "vitest": "5.1.1"
  }
