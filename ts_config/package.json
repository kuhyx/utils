{
  "name": "@kuhyx/ts-config",
  "version": "0.1.2",
  "private": false,
  "type": "module",
  "description": "The one lint/TypeScript bar every kuhyx TypeScript repo extends: a strict tsconfig base, ESLint flat-config presets (base, react, vitest, playwright, layer boundaries, a fast editor subset), and Knip / jscpd / Stryker bases. Plain JS, no build step -- consumable straight from a git tag.",
  "license": "MIT",
  "engines": {
    "node": ">=24",
    "pnpm": ">=10"
  },
  "packageManager": "pnpm@12.9.0+sha512.8f64efa0b792986ca98ae568791bcd7722807e274c4f0c1d9853c62116495c584119db98762a2a5343b1684d361b9ae26fdd16d551666d7635346d3fae830ddd",
  "files": [
    "eslint",
    "tsconfig.base.json",
    "knip.base.json",
    "jscpd.base.json",
    "stryker.base.mjs",
    "scripts",
    "README.md"
  ],
  "exports": {
    ".": "./eslint/index.js",
    "./eslint": "./eslint/index.js",
    "./eslint/base": "./eslint/base.js",
    "./eslint/react": "./eslint/react.js",
    "./eslint/vitest": "./eslint/vitest.js",
    "./eslint/playwright": "./eslint/playwright.js",
    "./eslint/boundaries": "./eslint/boundaries.js",
    "./eslint/fast": "./eslint/fast.js",
    "./tsconfig": "./tsconfig.base.json",
    "./knip": "./knip.base.json",
    "./jscpd": "./jscpd.base.json",
    "./stryker": "./stryker.base.mjs"
  },
  "scripts": {
    "lint": "eslint .",
    "test": "vitest run",
    "coverage": "vitest run --coverage"
  },
  "dependencies": {
    "@eslint-react/eslint-plugin": "5.23.5",
    "@eslint/js": "10.0.1",
    "@vitest/eslint-plugin": "1.6.27",
    "eslint-import-resolver-typescript": "4.4.5",
    "eslint-plugin-boundaries": "7.2.0",
    "eslint-plugin-jsx-a11y": "6.10.2",
    "eslint-plugin-perfectionist": "5.12.1",
    "eslint-plugin-playwright": "2.12.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-react-refresh": "0.5.7",
    "eslint-plugin-react-you-might-not-need-an-effect": "1.0.2",
    "eslint-plugin-sonarjs": "4.2.2",
    "eslint-plugin-unicorn": "77.0.0",
    "globals": "17.13.0"
  },
  "peerDependencies": {
    "eslint": ">=10",
    "typescript": ">=6",
    "typescript-eslint": ">=8.70.0"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@types/react": "19.3.0",
    "@vitest/coverage-v8": "5.0.3",
    "eslint": "10.12.0",
    "react": "19.3.0",
    "typescript": "6.0.3",
    "typescript-eslint": "8.71.0",
    "vitest": "5.0.3"
  }
}
