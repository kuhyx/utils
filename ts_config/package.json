{
  "name": "@kuhyx/ts-config",
  "version": "0.1.3",
  "private": false,
  "type": "module",
  "description": "The one lint/TypeScript bar every kuhyx TypeScript repo extends: a strict tsconfig base, ESLint flat-config presets (base, react, vitest, playwright, layer boundaries, a fast editor subset), and Knip / jscpd / Stryker bases. Plain JS, no build step -- consumable straight from a git tag.",
  "license": "MIT",
  "engines": {
    "node": ">=24",
    "pnpm": ">=10"
  },
  "packageManager": "pnpm@12.18.0+sha512.9d7882d5dc82147ecfc4e062aa34834e0ad0296710a1837a1115ae012127d36b7109e321ac1598a1dd0a65597681b1e99917e12ed0d749eae91187943363beb3",
  "files": [
    "eslint",
    "tsconfig.base.json",
    "knip.base.json",
    "jscpd.base.json",
    "stryker.base.mjs",
    "scripts",
    "README.md"
  ],
  "exports": {
    ".": "./eslint/index.js",
    "./eslint": "./eslint/index.js",
    "./eslint/base": "./eslint/base.js",
    "./eslint/react": "./eslint/react.js",
    "./eslint/vitest": "./eslint/vitest.js",
    "./eslint/playwright": "./eslint/playwright.js",
    "./eslint/boundaries": "./eslint/boundaries.js",
    "./eslint/fast": "./eslint/fast.js",
    "./tsconfig": "./tsconfig.base.json",
    "./knip": "./knip.base.json",
    "./jscpd": "./jscpd.base.json",
    "./stryker": "./stryker.base.mjs"
  },
  "scripts": {
    "lint": "eslint .",
    "test": "vitest run",
    "coverage": "vitest run --coverage"
  },
  "dependencies": {
    "@eslint-react/eslint-plugin": "5.28.8",
    "@eslint/js": "10.0.1",
    "@vitest/eslint-plugin": "1.6.28",
    "eslint-import-resolver-typescript": "4.4.5",
    "eslint-plugin-boundaries": "7.4.2",
    "eslint-plugin-jsx-a11y": "6.10.2",
    "eslint-plugin-perfectionist": "5.13.0",
    "eslint-plugin-playwright": "2.12.2",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-react-refresh": "0.5.7",
    "eslint-plugin-react-you-might-not-need-an-effect": "1.1.0",
    "eslint-plugin-sonarjs": "4.2.2",
    "eslint-plugin-unicorn": "79.0.0",
    "globals": "17.14.0"
  },
  "peerDependencies": {
    "eslint": "10.14.0",
    "typescript": ">=6",
    "typescript-eslint": "8.72.1"
  },
  "devDependencies": {
    "@playwright/test": "1.65.0",
    "@types/react": "19.3.0",
    "@vitest/coverage-v8": "5.1.0",
    "eslint": "10.14.0",
    "react": "19.3.1",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.1",
    "vitest": "5.1.0"
  }
}
