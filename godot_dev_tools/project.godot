; The stub host project of the dev_tools addon: it exists only so GUT can load
; addons/dev_tools headless. A game mounts the addon folder, not this project.

config_version=5

[application]

config/name="dev_tools_test_host"
config/features=PackedStringArray("4.7", "GL Compatibility")

[display]

window/size/viewport_width=640
window/size/viewport_height=360

[rendering]

renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
